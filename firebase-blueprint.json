{
  "entities": {
    "User": {
      "title": "User",
      "description": "Application user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] }
      },
      "required": ["uid", "email"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "totalPrice": { "type": "number" },
        "currency": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "screenshotUrl": { "type": "string", "description": "Base64 encoded payment screenshot" },
        "deliveryData": { "type": "string", "description": "Account details or product keys" },
        "status": { "type": "string", "enum": ["pending", "processing", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "totalPrice", "status", "createdAt"]
    },
    "GameRequest": {
      "title": "GameRequest",
      "description": "User request for a game",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "gameTitle": { "type": "string" },
        "platform": { "type": "string" },
        "contactInfo": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "fulfilled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["gameTitle", "contactInfo", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "/game_requests/{requestId}": {
      "schema": "GameRequest",
      "description": "Requests for games from customers"
    }
  }
}
